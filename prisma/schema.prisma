// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// CORE & RBAC TIZIMI (Multi-Tenancy)
// ==========================================

model Tenant {
  id          String   @id @default(uuid())
  name        String   @unique
  domain      String?  @unique
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  roles       Role[]
  schedules   Schedule[]
  reminders   Reminder[]
  cards       BusinessCard[]
  courses     Course[]
  tables      RestaurantTable[]
  employees   Employee[]
  suppliers   Supplier[]
  products    Product[]
  customers   Customer[]
  couriers    Courier[]
  contacts    Contact[]
  deals       Deal[]
  tasks       Task[]
  logs        SystemLog[]

  @@index([isActive])
}

model User {
  id                 String              @id @default(uuid())
  tenantId           String
  email              String              @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  roleId             String
  isDeleted          Boolean             @default(false)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  role               Role                @relation(fields: [roleId], references: [id])
  featureAccess      UserFeatureAccess?
  faceAuth           FaceAuthData?
  sessions           Session[]
  logs               SystemLog[]
  createdSchedules   Schedule[]          @relation("ScheduleCreator")
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  dealsManaged       Deal[]              @relation("DealManager")
  studentProfile     Student?

  @@index([tenantId])
  @@index([email])
  @@index([roleId])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  name        String           // e.g. "Ultra Admin", "Super Admin", "Developer", "Manager", "User"
  description String?
  isSystem    Boolean          @default(false) // Tizim tomondan o'rnatilgan rollar
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(uuid())
  action      String           // e.g., "CREATE", "READ", "UPDATE", "DELETE"
  subject     String           // e.g., "USER", "MENU_ITEM", "DEAL"
  description String?
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@unique([action, subject])
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserFeatureAccess {
  id                 String   @id @default(uuid())
  userId             String   @unique
  personalAccess     Boolean  @default(true)
  businessCardAccess Boolean  @default(true)
  educationAccess    Boolean  @default(true)
  restaurantAccess   Boolean  @default(true)
  salesAccess        Boolean  @default(true)
  crmAccess          Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id])
}

model FaceAuthData {
  id          String   @id @default(uuid())
  userId      String   @unique
  faceVector  Bytes    // Python OpenCV/Face_Recognition uchun yuz encoding ma'lumoti (BYTEA)
  photoUrl    String?  // Havola sifatida ham rasm saqlanishi mumkin
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SystemLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String   // e.g., "CREATE_ORDER", "DELETE_CONTACT"
  entityType String   // e.g., "Order", "Contact"
  entityId   String?
  metadata   Json?    // O'zgarishlar tarixi va qo'shimcha ma'lumotlar
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

// ==========================================
// 1. PERSONAL SECTION (Taym-Menejment)
// ==========================================

model Schedule {
  id          String   @id @default(uuid())
  tenantId    String
  creatorId   String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  isAllDay    Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  creator     User     @relation("ScheduleCreator", fields: [creatorId], references: [id])

  @@index([tenantId])
  @@index([startTime, endTime])
  @@index([isDeleted])
}

model Reminder {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  message     String?
  triggerTime DateTime
  isTriggered Boolean  @default(false)
  channel     String   // e.g., "SYSTEM", "TELEGRAM", "EMAIL"
  cronExpr    String?  // Agar davriy bo'lsa cron expression
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([triggerTime, isTriggered])
  @@index([isDeleted])
}

model NewsCache {
  id        String   @id @default(uuid())
  query     String   @unique
  results   Json     // Google Custom Search API dan kelgan natijalar keshi
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ==========================================
// 2. BUSINESS CARD (Vizitka Konstruktori)
// ==========================================

model BusinessCard {
  id           String               @id @default(uuid())
  tenantId     String
  companyName  String
  phone        String
  email        String?
  serviceType  String
  slug         String               @unique // URL uchun vizitka unikal nomi
  templateName String               @default("default") // UI dizayn shabloni
  isDeleted    Boolean              @default(false)
  deletedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  socials      BusinessCardSocial[]
  qrCode       QRCode?

  @@index([tenantId])
  @@index([isDeleted])
}

model BusinessCardSocial {
  id             String       @id @default(uuid())
  businessCardId String
  platform       String       // e.g., "TELEGRAM", "FACEBOOK", "INSTAGRAM", "LINKEDIN"
  username       String       // Username yoki to'liq link

  businessCard   BusinessCard @relation(fields: [businessCardId], references: [id])
}

model QRCode {
  id             String       @id @default(uuid())
  businessCardId String       @unique
  codeUrl        String       // QR-kod tasviri joylashgan manzil (Base64 yoki S3 link)
  downloadCount  Int          @default(0)
  createdAt      DateTime     @default(now())

  businessCard   BusinessCard @relation(fields: [businessCardId], references: [id])
}

// ==========================================
// 3. EDUCATION MODULI
// ==========================================

model Course {
  id          String            @id @default(uuid())
  tenantId    String
  title       String
  description String?
  coverImage  String?
  category    String
  isPublished Boolean           @default(false)
  isDeleted   Boolean           @default(false)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  lessons     Lesson[]
  quizzes     Quiz[]
  resources   LibraryResource[]

  @@index([tenantId])
}

model Lesson {
  id          String            @id @default(uuid())
  courseId    String
  title       String
  content     String?           // Matnli dars materiallari
  videoUrl    String?           // Video havola (YouTube, Vimeo yoki private storage)
  orderIndex  Int               @default(0)
  isDeleted   Boolean           @default(false)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  course      Course            @relation(fields: [courseId], references: [id])
  progress    StudentProgress[]

  @@index([courseId])
}

model Teacher {
  id        String   @id @default(uuid())
  name      String
  email     String?
  bio       String?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id         String            @id @default(uuid())
  userId     String            @unique
  xp         Int               @default(0) // Gamification ochkolari
  level      Int               @default(1)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user       User              @relation(fields: [userId], references: [id])
  progress   StudentProgress[]
  badges     StudentBadge[]

  @@index([userId])
}

model StudentProgress {
  id          String   @id @default(uuid())
  studentId   String
  lessonId    String
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id])
  lesson      Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([studentId, lessonId])
  @@index([studentId])
}

model Quiz {
  id          String         @id @default(uuid())
  courseId    String
  title       String
  passingScore Int           @default(80) // % hisobida
  isDeleted   Boolean        @default(false)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())

  course      Course         @relation(fields: [courseId], references: [id])
  questions   QuizQuestion[]

  @@index([courseId])
}

model QuizQuestion {
  id          String       @id @default(uuid())
  quizId      String
  questionText String
  points      Int          @default(10)
  createdAt   DateTime     @default(now())

  quiz        Quiz         @relation(fields: [quizId], references: [id])
  answers     QuizAnswer[]
}

model QuizAnswer {
  id          String       @id @default(uuid())
  questionId  String
  answerText  String
  isCorrect   Boolean      @default(false)

  question    QuizQuestion @relation(fields: [questionId], references: [id])
}

model Badge {
  id          String         @id @default(uuid())
  name        String         @unique
  description String
  iconUrl     String
  xpRequired  Int            @default(0)
  createdAt   DateTime       @default(now())

  students    StudentBadge[]
}

model StudentBadge {
  studentId String
  badgeId   String
  earnedAt  DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@id([studentId, badgeId])
}

model LibraryResource {
  id          String   @id @default(uuid())
  courseId    String?
  title       String
  fileUrl     String   // PDF, DOCX va hokazo fayllar havolasi
  fileType    String   // e.g., "pdf", "zip"
  fileSize    Int      // Baytlarda
  createdAt   DateTime @default(now())

  course      Course?  @relation(fields: [courseId], references: [id])
}

// ==========================================
// 4. SMART RESTAURANT (Restoran Boshqaruvi)
// ==========================================

enum TableStatus {
  VACANT           // Bo'sh
  OCCUPIED         // Band
  RESERVED         // Bron
  PAYMENT_PENDING  // To'lov kutilmoqda
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

model RestaurantTable {
  id        String      @id @default(uuid())
  tenantId  String
  tableNo   Int         // 1 dan 12 gacha va hokazo
  capacity  Int         @default(4)
  status    TableStatus @default(VACANT)
  isDeleted Boolean     @default(false)
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  orders    Order[]

  @@unique([tenantId, tableNo])
  @@index([tenantId])
  @@index([status])
}

model Order {
  id          String      @id @default(uuid())
  tenantId    String
  tableId     String
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)
  orderedAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isDeleted   Boolean     @default(false)
  deletedAt   DateTime?

  table       RestaurantTable @relation(fields: [tableId], references: [id])
  items       OrderItem[]
  receipt     Receipt?

  @@index([tableId])
  @@index([status])
  @@index([orderedAt])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  notes      String?

  order      Order    @relation(fields: [orderId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model MenuItem {
  id          String        @id @default(uuid())
  categoryId  String
  name        String
  description String?
  price       Decimal       @db.Decimal(12, 2)
  imageUrl    String?
  isAvailable Boolean       @default(true)
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    MenuCategory  @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
}

model MenuCategory {
  id        String     @id @default(uuid())
  name      String
  isDeleted Boolean    @default(false)
  deletedAt DateTime?
  createdAt DateTime   @default(now())

  items     MenuItem[]
}

model Employee {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String
  phone     String?
  role      String   // e.g., "WAITER", "CHEF", "CASHIER", "MANAGER"
  status    String   // e.g., "ACTIVE", "INACTIVE"
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Warehouse {
  id             String           @id @default(uuid())
  name           String           // Mahsulot nomi (kartoshka, go'sht va hk)
  unit           String           // kg, litr, dona
  currentQty     Decimal          @db.Decimal(12, 3)
  minimumQty     Decimal          @db.Decimal(12, 3) // Zaxira shu miqdordan kamaysa alert beriladi
  isDeleted      Boolean          @default(false)
  deletedAt      DateTime?
  updatedAt      DateTime         @updatedAt
  createdAt      DateTime         @default(now())

  alerts         WarehouseAlert[]
}

model WarehouseAlert {
  id          String    @id @default(uuid())
  itemId      String
  message     String
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  item        Warehouse @relation(fields: [itemId], references: [id])
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phone     String
  balance   Decimal  @db.Decimal(12, 2) @default(0.00) // Yetkazib beruvchiga bo'lgan qarzimiz yoki hisobimiz
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Expense {
  id          String          @id @default(uuid())
  categoryId  String
  amount      Decimal         @db.Decimal(12, 2)
  description String
  expenseDate DateTime        // Sana majburiy
  createdAt   DateTime        @default(now())

  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([expenseDate])
}

model ExpenseCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  expenses  Expense[]
}

enum PaymentType {
  CASH
  CARD
  MIXED
}

model Receipt {
  id            String      @id @default(uuid())
  orderId       String?     @unique
  salesOrderId  String?     @unique
  totalAmount   Decimal     @db.Decimal(12, 2)
  paymentType   PaymentType @default(CASH)
  cashAmount    Decimal     @db.Decimal(12, 2) @default(0.00)
  cardAmount    Decimal     @db.Decimal(12, 2) @default(0.00)
  taxPercentage Decimal     @db.Decimal(5, 2) @default(12.00) // QQS
  isTaxReported Boolean     @default(false)
  taxReceiptNo  String?     // Soliq qo'mitasi (NKM) chek raqami
  isDeleted     Boolean     @default(false)
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())

  order         Order?      @relation(fields: [orderId], references: [id])
  salesOrder    SalesOrder? @relation(fields: [salesOrderId], references: [id])

  @@index([createdAt])
}

// ==========================================
// 5. SMART SALES (Onlayn Magazin)
// ==========================================

enum DeliveryStatus {
  RECEIVED
  PACKING
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

model Product {
  id          String          @id @default(uuid())
  tenantId    String
  categoryId  String
  name        String
  description String?
  price       Decimal         @db.Decimal(12, 2)
  stockQty    Int             @default(0)
  minStockQty Int             @default(5) // Tugab qolganda ogohlantirish uchun
  barcode     String?         @unique // Shtrix-kod
  imageUrl    String?
  isDeleted   Boolean         @default(false)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  salesItems  SalesOrderItem[]
  barcodeScans BarcodeScan[]

  @@index([tenantId])
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  products  Product[]
}

model SalesOrder {
  id             String          @id @default(uuid())
  customerId     String
  status         DeliveryStatus  @default(RECEIVED)
  paymentStatus  PaymentStatus   @default(PENDING)
  totalAmount    Decimal         @db.Decimal(12, 2)
  salesChannelId String
  isDeleted      Boolean         @default(false)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id])
  salesChannel   SalesChannel    @relation(fields: [salesChannelId], references: [id])
  items          SalesOrderItem[]
  delivery       Delivery?
  payment        Payment?
  installments   Installment[]
  receipt        Receipt?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model SalesOrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)

  order     SalesOrder @relation(fields: [orderId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])
}

model Customer {
  id         String       @id @default(uuid())
  tenantId   String
  name       String
  email      String?
  phone      String
  rfmSegment RFM_Segment  @default(PASSIVE)
  isDeleted  Boolean      @default(false)
  deletedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  orders     SalesOrder[]
  contacts   Contact[]

  @@index([tenantId])
  @@index([phone])
}

enum RFM_Segment {
  TOP
  CHURN_RISK
  PASSIVE
}

model Courier {
  id        String     @id @default(uuid())
  tenantId  String
  name      String
  phone     String
  status    String     // e.g., "FREE", "BUSY", "OFFLINE"
  isDeleted Boolean    @default(false)
  deletedAt DateTime?
  createdAt DateTime   @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  deliveries Delivery[]

  @@index([tenantId])
}

model Delivery {
  id             String         @id @default(uuid())
  orderId        String         @unique
  courierId      String?
  status         DeliveryStatus @default(RECEIVED)
  shippingAddress String
  deliveryMapLat Decimal?       @db.Decimal(10, 8)
  deliveryMapLng Decimal?       @db.Decimal(11, 8)
  deliveredAt    DateTime?
  updatedAt      DateTime       @updatedAt

  order          SalesOrder     @relation(fields: [orderId], references: [id])
  courier        Courier?       @relation(fields: [courierId], references: [id])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  provider      String        // Click, Payme, Uzum, Visa, Mastercard
  transactionId String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  order         SalesOrder    @relation(fields: [orderId], references: [id])
}

model Installment {
  id             String               @id @default(uuid())
  orderId        String
  totalAmount    Decimal              @db.Decimal(12, 2)
  monthsCount    Int                  // Masalan 12 oy
  monthlyAmount  Decimal              @db.Decimal(12, 2)
  nextPayDate    DateTime
  isCompleted    Boolean              @default(false)
  isDeleted      Boolean              @default(false)
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())

  order          SalesOrder           @relation(fields: [orderId], references: [id])
  payments       InstallmentPayment[]

  @@index([orderId])
}

model InstallmentPayment {
  id            String   @id @default(uuid())
  installmentId String
  amountPaid    Decimal  @db.Decimal(12, 2)
  paidAt        DateTime @default(now())
  paymentMethod String   // click, payme, cash...

  installment   Installment @relation(fields: [installmentId], references: [id])
}

model BarcodeScan {
  id        String   @id @default(uuid())
  productId String
  barcode   String
  scannedAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id])
}

model SalesChannel {
  id        String           @id @default(uuid())
  name      String           // Masalan "Main Website", "Telegram Bot @futurenet_bot", "Instagram Shop"
  type      SalesChannelType
  config    Json?            // Bot token, API webhook ma'lumotlari
  createdAt DateTime         @default(now())

  orders    SalesOrder[]
}

enum SalesChannelType {
  WEB
  TELEGRAM
  INSTAGRAM
}

// ==========================================
// 6. CUSTOMER RELATIONSHIP MANAGEMENT (CRM)
// ==========================================

model Contact {
  id           String               @id @default(uuid())
  tenantId     String
  customerId   String?
  name         String
  phone        String
  email        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  isDeleted    Boolean              @default(false)
  deletedAt    DateTime?

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  customer     Customer?            @relation(fields: [customerId], references: [id])
  interactions ContactInteraction[]
  deals        Deal[]
  tasks        Task[]

  @@index([tenantId])
  @@index([phone])
}

model ContactInteraction {
  id            String   @id @default(uuid())
  contactId     String
  channel       String   // e.g. "TELEGRAM", "PHONE", "EMAIL", "IN_PERSON"
  messageText   String?
  type          String   // e.g., "INCOMING", "OUTGOING"
  interactionAt DateTime @default(now())

  contact       Contact  @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([interactionAt])
}

model Deal {
  id        String    @id @default(uuid())
  tenantId  String
  contactId String
  managerId String    // Mas'ul menejer (User)
  title     String
  value     Decimal   @db.Decimal(12, 2)
  stageId   String
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  contact   Contact   @relation(fields: [contactId], references: [id])
  manager   User      @relation("DealManager", fields: [managerId], references: [id])
  stage     DealStage @relation(fields: [stageId], references: [id])

  @@index([tenantId])
  @@index([managerId])
  @@index([stageId])
}

model DealStage {
  id        String   @id @default(uuid())
  name      String   // NEW, NEGOTIATION, PROPOSAL, CONTRACT, CLOSED_WON, CLOSED_LOST
  orderNo   Int      @default(0) // Kanban taxtasidagi tartibi
  createdAt DateTime @default(now())

  deals     Deal[]
}

model Task {
  id          String    @id @default(uuid())
  tenantId    String
  creatorId   String
  assigneeId  String
  contactId   String?
  title       String
  description String?
  dueDate     DateTime
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  isAutomated Boolean   @default(false) // Avtomat ochilgan bo'lsa true (e.g. 14 kun aloqa bo'lmaganda)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  creator     User      @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee    User      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  contact     Contact?  @relation(fields: [contactId], references: [id])

  @@index([tenantId])
  @@index([assigneeId])
  @@index([dueDate])
}

model CRMNotification {
  id          String   @id @default(uuid())
  userId      String   // Kimga yuborilganligi
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model AdChannel {
  id          String          @id @default(uuid())
  name        String          // Masalan "Google Ads", "Facebook Lead", "Telegram Ads"
  cost        Decimal         @db.Decimal(12, 2)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime        @default(now())

  stats       AdChannelStat[]
}

model AdChannelStat {
  id           String    @id @default(uuid())
  adChannelId  String
  leadsCount   Int       @default(0)
  dealsCount   Int       @default(0)
  revenue      Decimal   @db.Decimal(12, 2) @default(0.00)
  statDate     DateTime  @default(now())

  adChannel    AdChannel @relation(fields: [adChannelId], references: [id])
}

model OmnichannelMessage {
  id          String   @id @default(uuid())
  senderPhone String
  senderName  String?
  platform    String   // e.g. "TELEGRAM", "INSTAGRAM", "WHATSAPP"
  messageId   String   // Tashqi tizimdagi xabar IDsi
  content     String
  receivedAt  DateTime @default(now())
  isProcessed Boolean  @default(false)

  @@index([senderPhone])
  @@index([receivedAt])
}
